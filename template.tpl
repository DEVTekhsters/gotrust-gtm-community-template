___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const injectScript = require('injectScript');
const callInWindow = require('callInWindow');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const queryPermission = require('queryPermission');
const logToConsole = require('logToConsole');
const createQueue = require('createQueue');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const getType = require('getType');

const DEDUP_KEY = '__gotrustGtmTemplateFired';

function debugLog() {
  if (data.debugMode) {
    logToConsole.apply(null, arguments);
  }
}

// Errors are always reported (regardless of Debug Mode) — both to the console and to the
// dataLayer as a `gotrust_template_error` event, so this can be picked up by monitoring/QA
// without requiring Debug Mode to be left on in production.
function reportError(stage, message) {
  logToConsole('[GoTrust CMP] ' + stage + ': ' + message);
  const pushToDataLayer = createQueue('dataLayer');
  pushToDataLayer({
    event: 'gotrust_template_error',
    gotrust_error_stage: stage,
    gotrust_error_message: message
  });
}

function isTwoLetterCode(str) {
  if (str.length !== 2) return false;
  const c0 = str.substring(0, 1);
  const c1 = str.substring(1, 2);
  return c0 >= 'A' && c0 <= 'Z' && c1 >= 'A' && c1 <= 'Z';
}

// --- 1. Read + validate required field values -------------------------------------------
const domainId = makeString(data.domainId || '').trim();
const domainUrl = makeString(data.domainUrl || '').trim();
const environment = makeString(data.environment || '').trim();
const bundleUrl = makeString(
  data.bundleUrl || 'https://cdn.gotrust.tech/gotrust-client'
).trim();
const mountSelector = makeString(data.mountSelector || '#gotrust-cookie-banner').trim();
const consentModeType = makeString(data.consentModeType || 'advanced');

if (!domainId) {
  reportError('config', 'domainId is required but empty.');
  data.gtmOnFailure();
  return;
}
if (domainUrl.substring(0, 7) !== 'http://' && domainUrl.substring(0, 8) !== 'https://') {
  reportError('config', 'domainUrl must start with http:// or https://.');
  data.gtmOnFailure();
  return;
}
if (environment.substring(0, 8) !== 'https://') {
  reportError('config', 'environment must be an https:// URL.');
  data.gtmOnFailure();
  return;
}
if (bundleUrl.substring(0, 8) !== 'https://') {
  reportError('config', 'bundleUrl must be an https:// URL.');
  data.gtmOnFailure();
  return;
}

// --- 2. Duplicate-execution guard --------------------------------------------------------
// Defensive: if this tag somehow fires more than once on the same page (e.g. misconfigured
// duplicate triggers), don't re-inject scripts or re-mount the banner.
if (copyFromWindow(DEDUP_KEY)) {
  debugLog('[GoTrust CMP] Tag already fired on this page — skipping duplicate execution.');
  data.gtmOnSuccess();
  return;
}
setInWindow(DEDUP_KEY, true, true);

// --- 3. Wait-for-update timing ------------------------------------------------------------
// "Basic" vs "Advanced" only controls how long OTHER tags wait for a consent decision before
// evaluating the default-denied state set below (the `wait_for_update` parameter) — it does
// NOT itself block or allow any tag from firing. Whether an individual tag fires pre-consent
// is controlled by that tag's own "Consent Settings" checks plus GTM's native handling of the
// default state. Basic = 0ms (other tags see the denied default immediately); Advanced =
// configurable wait window (falls back to 500ms if unset/invalid).
let waitForUpdateMs = 0;
if (consentModeType === 'advanced') {
  const parsedWait = makeInteger(data.waitForUpdateMs);
  waitForUpdateMs = getType(parsedWait) === 'number' && parsedWait > 0 ? parsedWait : 500;
}

// --- 4. Set the Consent Mode baseline immediately -----------------------------------------
// Same 7 keys/defaults as the GoTrust product's own gtm-consent-manager.ts defaultConsentState
// — kept in sync deliberately, not reinvented.
const defaultConsentSettings = {
  ad_storage: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  wait_for_update: waitForUpdateMs
};

const regionsRaw = makeString(data.regions || '');
if (regionsRaw.length > 0) {
  const rawParts = regionsRaw.split(',');
  const regions = [];
  for (let i = 0; i < rawParts.length; i++) {
    const trimmed = rawParts[i].trim().toUpperCase();
    if (trimmed.length === 0) {
      continue;
    }
    if (isTwoLetterCode(trimmed)) {
      regions.push(trimmed);
    } else {
      debugLog('[GoTrust CMP] Ignoring invalid region code: ' + trimmed);
    }
  }
  if (regions.length > 0) {
    defaultConsentSettings.region = regions;
  }
}

// Fire this tag on the "Consent Initialization - All Pages" trigger with the highest firing
// priority so this runs before any other tag in the container. There is no reliable way for
// sandboxed JavaScript to detect which trigger fired it, so this cannot be enforced at
// runtime — see the template Notes and README for this requirement.
setDefaultConsentState(defaultConsentSettings);
debugLog('[GoTrust CMP] Default consent state set:', defaultConsentSettings);

// --- 5. Load the GoTrust CMP bundle and mount the banner -----------------------------------
// The banner itself (existing, unchanged product code) owns consent restoration for
// returning visitors and pushes gtag('consent','update',...) / dataLayer updates — this
// template does not duplicate that logic, it only bootstraps loading + mounting.
const shimUrl = bundleUrl + '/gotrust-consent-shim.js';
const fullBundleUrl = bundleUrl + '/cookie-banner.bundle.js';

function onSdkReady() {
  const initFn = copyFromWindow('CookieBanner.init');
  if (getType(initFn) !== 'function') {
    reportError(
      'sdk_api_missing',
      'window.CookieBanner.init is not available after the bundle loaded — the GoTrust SDK may have changed its public API.'
    );
    data.gtmOnFailure();
    return;
  }
  callInWindow('CookieBanner.init', mountSelector, {
    domainUrl: domainUrl,
    environment: environment,
    domain_id: domainId
  });
  data.gtmOnSuccess();
}

function onBundleLoadFailure() {
  reportError('bundle_load_failed', 'Failed to load cookie-banner.bundle.js from ' + fullBundleUrl);
  data.gtmOnFailure();
}

function loadBundle() {
  if (queryPermission('inject_script', fullBundleUrl)) {
    injectScript(fullBundleUrl, onSdkReady, onBundleLoadFailure);
  } else {
    reportError('permission_denied', 'Missing inject_script permission for ' + fullBundleUrl);
    data.gtmOnFailure();
  }
}

function onShimLoadFailure() {
  reportError('shim_load_failed', 'Failed to load gotrust-consent-shim.js from ' + shimUrl);
  data.gtmOnFailure();
}

if (queryPermission('inject_script', shimUrl)) {
  injectScript(shimUrl, loadBundle, onShimLoadFailure);
} else {
  reportError('permission_denied', 'Missing inject_script permission for ' + shimUrl);
  data.gtmOnFailure();
}


